rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per household. The long random household code is the key:
    // anyone who knows it can use the board, and nobody can list households.
    match /households/{householdId} {
      allow get, create, update: if householdId.size() >= 10;
      allow list, delete: if false;

      // Phones using the web board register here so the alert server can reach them.
      match /devices/{deviceId} {
        allow get, create, update, delete: if householdId.size() >= 10;
        allow list: if false;
      }
    }
  }
}
